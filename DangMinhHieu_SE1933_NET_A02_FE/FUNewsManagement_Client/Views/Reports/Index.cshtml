@model List<FUNewsManagement_DAL.Entities.NewsArticle>
@{
    ViewData["Title"] = "Reports & Statistics";
    string startDate = ViewBag.StartDate as string ?? "";
    string endDate = ViewBag.EndDate as string ?? "";
    int total = ViewBag.TotalArticles ?? 0;
    int active = ViewBag.ActiveCount ?? 0;
    int inactive = ViewBag.InactiveCount ?? 0;
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-bar-chart-line text-primary me-2"></i>Articles Analytics & Report
        </h1>
        <p class="text-muted mb-0">Period-based statistical report sorted descending by creation date.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-print-none">
        <button class="btn btn-outline-secondary me-2" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / PDF
        </button>
        <button class="btn btn-outline-success" onclick="exportTableToCSV('news_report.csv')">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card">
            <div class="stat-icon bg-primary text-white">
                <i class="bi bi-newspaper"></i>
            </div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Articles in Period</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card">
            <div class="stat-icon bg-success text-white">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Published / Active Articles</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card">
            <div class="stat-icon bg-warning text-white">
                <i class="bi bi-dash-circle"></i>
            </div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Draft / Inactive Articles</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Box -->
<div class="card card-custom mb-4 d-print-none">
    <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-funnel me-1 text-primary"></i> Filter Date Range (by Created Date)</h6>
        <form method="get" asp-action="Index" id="reportFilterForm" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="startDate" class="form-label fw-semibold small">Start Date</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="@startDate" />
                </div>
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label fw-semibold small">End Date</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="@endDate" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filter">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>

        <!-- Quick Presets -->
        <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center gap-2">
            <span class="small text-muted me-2">Quick Presets:</span>
            <button type="button" class="btn btn-sm btn-light border" onclick="setDatePreset('today')">Today</button>
            <button type="button" class="btn btn-sm btn-light border" onclick="setDatePreset('7days')">Last 7 Days</button>
            <button type="button" class="btn btn-sm btn-light border" onclick="setDatePreset('30days')">Last 30 Days</button>
            <button type="button" class="btn btn-sm btn-light border" onclick="setDatePreset('thisMonth')">This Month</button>
            <button type="button" class="btn btn-sm btn-light border" onclick="setDatePreset('allTime')">All Time</button>
        </div>
    </div>
</div>

<!-- Report Table Card -->
<div class="card card-custom">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold">Report Results</h5>
            <small class="text-muted">
                @if (!string.IsNullOrEmpty(startDate) || !string.IsNullOrEmpty(endDate))
                {
                    <span>Filtered from <strong>@(string.IsNullOrEmpty(startDate) ? "Earliest" : startDate)</strong> to <strong>@(string.IsNullOrEmpty(endDate) ? "Latest" : endDate)</strong></span>
                }
                else
                {
                    <span>Showing all recorded articles sorted descending by Created Date</span>
                }
            </small>
        </div>
        <span class="badge bg-primary rounded-pill px-3 py-2">@total Records</span>
    </div>
    <div class="table-responsive">
        <table class="table modern-table align-middle mb-0" id="reportTable">
            <thead>
                <tr>
                    <th style="width: 100px;">Article ID</th>
                    <th>Title & Category</th>
                    <th>Author (Created By)</th>
                    <th style="width: 170px;">Created Date</th>
                    <th style="width: 120px;">Status</th>
                    <th style="width: 90px;" class="text-center d-print-none">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">@item.NewsArticleId</span></td>
                            <td>
                                <div class="fw-bold text-dark">@item.NewsTitle</div>
                                <div class="small text-muted">
                                    <span class="badge bg-secondary-subtle text-secondary me-1">@(item.Category?.CategoryName ?? "No Category")</span>
                                    @if (!string.IsNullOrEmpty(item.Headline))
                                    {
                                        <span class="text-truncate d-inline-block" style="max-width: 320px;" title="@item.Headline">@item.Headline</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.CreatedBy != null)
                                {
                                    <div class="fw-semibold">@item.CreatedBy.AccountName</div>
                                    <small class="text-muted">@item.CreatedBy.AccountEmail</small>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">ID: @item.CreatedById</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    <i class="bi bi-clock me-1 text-muted"></i>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                                </div>
                            </td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge badge-status-active">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-status-inactive">
                                        <i class="bi bi-dash-circle-fill me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-center d-print-none">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.NewsArticleId" 
                                   target="_blank" class="btn btn-sm btn-outline-primary" title="View Public Article">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
                            <h5 class="text-muted fw-normal">No articles found in this period</h5>
                            <p class="text-muted small">Try expanding the date range filter above or resetting the filters.</p>
                            <a asp-action="Index" class="btn btn-sm btn-outline-primary">Reset Filter</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function setDatePreset(preset) {
            const today = new Date();
            const format = (d) => d.toISOString().split('T')[0];
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (preset === 'today') {
                startInput.value = format(today);
                endInput.value = format(today);
            } else if (preset === '7days') {
                const past7 = new Date();
                past7.setDate(today.getDate() - 7);
                startInput.value = format(past7);
                endInput.value = format(today);
            } else if (preset === '30days') {
                const past30 = new Date();
                past30.setDate(today.getDate() - 30);
                startInput.value = format(past30);
                endInput.value = format(today);
            } else if (preset === 'thisMonth') {
                const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
                startInput.value = format(firstDay);
                endInput.value = format(today);
            } else if (preset === 'allTime') {
                startInput.value = '';
                endInput.value = '';
            }
            document.getElementById('reportFilterForm').submit();
        }

        function exportTableToCSV(filename) {
            const rows = document.querySelectorAll("#reportTable tr");
            let csv = [];
            for (let i = 0; i < rows.length; i++) {
                const row = [], cols = rows[i].querySelectorAll("td, th");
                // skip last action col
                const maxCol = cols.length > 5 ? 5 : cols.length;
                for (let j = 0; j < maxCol; j++) {
                    let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/\s+/g, " ").trim();
                    data = data.replace(/"/g, '""');
                    row.push('"' + data + '"');
                }
                csv.push(row.join(","));
            }
            const csvFile = new Blob([csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            const downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
